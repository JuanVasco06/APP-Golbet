@* GolBet.Web/Views/Matches/Detail.cshtml *@
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model GolBet.Services.DTOs.MatchDetailDto
@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Partidos</a></li>
        <li class="breadcrumb-item active">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 @Model.Date.ToColombiaTime().ToString("dddd dd MMM yyyy · h:mm tt")</span>
        @switch (Model.Status)
        {
            case MatchStatus.Scheduled:
                <span class="badge bg-primary">Programado</span>
                break;
            case MatchStatus.InProgress:
                <span class="badge bg-warning text-dark">En juego</span>
                break;
            case MatchStatus.Finished:
                <span class="badge bg-secondary">Finalizado</span>
                break;
        }
    </div>

    <div class="card-body">
        <div class="match-detail-teams d-flex justify-content-around align-items-center text-center py-3">
            <div>
                <img src="@(Model.HomeTeamCrestUrl ?? "/images/crests/fc.svg")"
                     alt="@Model.HomeTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.HomeTeamName</h4>
            </div>

            <div class="px-4 text-nowrap">
                @if (Model.Status == MatchStatus.Finished)
                {
                    <span class="display-4 fw-bold">@Model.HomeGoals - @Model.AwayGoals</span>
                }
                else
                {
                    <span class="display-6 text-muted">vs</span>
                }
            </div>

            <div>
                <img src="@(Model.AwayTeamCrestUrl ?? "/images/crests/fc.svg")"
                     alt="@Model.AwayTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.AwayTeamName</h4>
            </div>
        </div>

        <hr />

        <h5 class="text-center mb-3">Cuotas</h5>
        <div class="row g-3 justify-content-center">
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">1 · @Model.HomeTeamName</div>
                    <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">X · Empate</div>
                    <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded text-center py-3">
                    <div class="text-muted">2 · @Model.AwayTeamName</div>
                    <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                </div>
            </div>
        </div>
        @if (Model.Status == MatchStatus.Scheduled && Model.Date > DateTime.UtcNow)
        {
            @if (User.IsInRole(DbSeeder.BettorRole))
            {
                <hr />
                <h5 class="text-center mb-3">🎯 Haz tu apuesta</h5>
                <form asp-controller="Bets" asp-action="Place" method="post" class="col-md-8 mx-auto">
                    <input type="hidden" name="MatchId" value="@Model.Id" />
                    <div class="input-group mb-3">
                        <label for="betAmount" class="input-group-text">Monto</label>
                        <input id="betAmount" name="Amount" type="number" step="0.01" min="1" max="9999999999"
                               value="1000" required class="form-control" aria-describedby="betHelp" />
                        <span class="input-group-text">FutCoins</span>
                    </div>
                    <div class="row g-2 text-center">
                        <div class="col">
                            <button type="submit" name="Pick" value="Home" class="btn btn-outline-success w-100">
                                1 · @Model.HomeOdds.ToString("0.00")
                            </button>
                        </div>
                        <div class="col">
                            <button type="submit" name="Pick" value="Draw" class="btn btn-outline-success w-100">
                                X · @Model.DrawOdds.ToString("0.00")
                            </button>
                        </div>
                        <div class="col">
                            <button type="submit" name="Pick" value="Away" class="btn btn-outline-success w-100">
                                2 · @Model.AwayOdds.ToString("0.00")
                            </button>
                        </div>
                    </div>
                    <small id="betHelp" class="text-muted d-block text-center mt-2">
                        Elige tu monto y haz clic en la cuota para apostar.
                    </small>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Detail", "Matches", new { id = Model.Id })"
                       class="btn btn-success">Inicia sesión para apostar</a>
                </div>
            }
        }
    </div>

    <div class="card-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Status == MatchStatus.Scheduled && Model.Date > DateTime.UtcNow)
            {
                @if (User.IsInRole(DbSeeder.AdminRole))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
                    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" data-confirm="¿Desactivar este partido?">
                        <button class="btn btn-outline-danger" type="submit">Desactivar</button>
                    </form>
                }
            }
            else { <span class="text-muted">Este partido ya no admite cambios.</span> }
        </div>
    </div>
</div>
